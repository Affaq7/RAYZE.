# --- Supabase ---
# Direct/connection-pooled Postgres URL from Supabase (Project Settings > Database > Connection string, URI, asyncpg-compatible).
# Use the "Transaction" pooler (port 6543) for the app at runtime, or the direct connection (port 5432) for running migrations.
# Format: postgresql+asyncpg://postgres:<password>@<host>:<port>/postgres
SUPABASE_DB_URL=postgresql+asyncpg://postgres:CHANGE_ME@db.your-project-ref.supabase.co:5432/postgres

# Project Settings > Data API (Project URL) -- base URL only, no path suffix
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings > API Keys > anon / publishable key
SUPABASE_ANON_KEY=your-anon-key
# Project Settings > API Keys > service_role / secret key (never expose to a browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# No JWT secret needed here: admin tokens are verified against Supabase's
# published JWKS (derived from SUPABASE_URL above), which keeps working
# through Supabase's own key rotations. See app/core/security.py.

# --- Resend (transactional email) ---
# https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# Verified sending address, e.g. "RAYZE <notifications@yourdomain.com>"
RESEND_FROM_EMAIL=RAYZE <notifications@yourdomain.com>
# Where contact/application notifications are sent
TEAM_NOTIFICATION_EMAIL=team@yourdomain.com

# --- App / Security ---
ENVIRONMENT=development
# Comma-separated list of allowed origins, no wildcards. e.g. https://rayze.com,https://www.rayze.com
# http://localhost:5500 is the local frontend prototype (see frontend/README.md)
# http://localhost:5501 is the local admin panel (see admin/README.md)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:5501

# --- Supabase Storage ---
PORTFOLIO_BUCKET=portfolio-images
RESUME_BUCKET=resumes

# --- Uploads ---
MAX_IMAGE_SIZE_MB=5
MAX_RESUME_SIZE_MB=5

# --- Google Sheets sync (leave blank until wired up — see README) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
